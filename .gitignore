# Never commit secrets
.env

# Generated files
outputs/*
!outputs/.gitkeep
__pycache__/
*.pyc

# ButaCut cache (waveforms/thumbnails)
butacut/cache/

# NOTE: assets/ and footage/ are deliberately NOT ignored — the fonts and the
# sample video must travel with this repo or nothing renders.

# edit/transcript sidecars are per-student working state, never shipped
footage/*.edit.json
footage/*.transcript.json
